---
import { useTranslations, type Lang } from '../i18n/config';
import { AUTHOR, SOCIAL } from '../consts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer>
  <div class="wrapper inner">
    <span>© {year} {AUTHOR}</span>
    <span class="links">
      <a href={SOCIAL.github} rel="me noopener" target="_blank">GitHub</a>
      <a href={SOCIAL.linkedin} rel="me noopener" target="_blank">LinkedIn</a>
      <a href={`mailto:${SOCIAL.email}`}>Email</a>
    </span>
    <span class="muted">{t('footer.builtWith')}</span>
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    padding-block: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
  }
  .links {
    display: flex;
    gap: 1rem;
  }
  .links a {
    color: var(--text-muted);
  }
  .links a:hover {
    color: var(--accent);
  }
</style>
