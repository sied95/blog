---
import { href } from '../lib/url';
import { slugOf, readingTime, type Post } from '../lib/posts';
import { useTranslations, type Lang } from '../i18n/config';
import FormattedDate from './FormattedDate.astro';

interface Props {
  post: Post;
  lang: Lang;
}

const { post, lang } = Astro.props;
const t = useTranslations(lang);
const url = href(`/${lang}/blog/${slugOf(post)}`);
const minutes = readingTime(post.body);
---

<article>
  <div class="meta">
    <FormattedDate date={post.data.pubDate} lang={lang} />
    <span aria-hidden="true">·</span>
    <span>{minutes} {t('post.readingTime')}</span>
    {post.data.draft && <span class="draft">draft</span>}
  </div>

  <h2><a href={url}>{post.data.title}</a></h2>
  <p class="muted">{post.data.description}</p>

  {
    post.data.tags.length > 0 && (
      <ul class="tags">
        {post.data.tags.map((tag) => (
          <li>
            <a href={href(`/${lang}/tags/${tag}`)}>#{tag}</a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  article {
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  article:last-child {
    border-bottom: none;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .draft {
    color: #d97706;
    border: 1px solid currentColor;
    border-radius: 4px;
    padding: 0 0.3rem;
  }
  h2 {
    font-size: 1.25rem;
    margin: 0.4rem 0 0.35rem;
  }
  h2 a {
    color: var(--text);
  }
  h2 a:hover {
    color: var(--accent);
    text-decoration: none;
  }
  p {
    margin: 0;
    font-size: 0.95rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0.7rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
  .tags a {
    color: var(--text-muted);
  }
  .tags a:hover {
    color: var(--accent);
    text-decoration: none;
  }
</style>
