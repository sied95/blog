---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { href } from '../lib/url';
import { useTranslations, type Lang } from '../i18n/config';
import { readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
  lang: Lang;
  altPath: string;
}

const { post, lang, altPath } = Astro.props;
const t = useTranslations(lang);
const { title, description, pubDate, updatedDate, tags } = post.data;
const minutes = readingTime(post.body);

// Só aparece no PDF, para o leitor saber de onde o arquivo veio
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  altPath={altPath}
  ogType="article"
>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <FormattedDate date={pubDate} lang={lang} />
        <span aria-hidden="true">·</span>
        <span>{minutes} {t('post.readingTime')}</span>
      </p>
      {
        updatedDate && (
          <p class="updated muted">
            {t('post.updated')} <FormattedDate date={updatedDate} lang={lang} />
          </p>
        )
      }
      {
        tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>
                <a href={href(`/${lang}/tags/${tag}`)}>#{tag}</a>
              </li>
            ))}
          </ul>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    <p class="print-only source">
      {t('post.source')} <span>{canonical}</span>
    </p>

    <nav class="back print-hide">
      <a href={href(`/${lang}/blog`)}>← {t('post.back')}</a>
      <button type="button" id="print-post">{t('post.print')}</button>
    </nav>
  </article>

  <script>
    document
      .getElementById('print-post')
      ?.addEventListener('click', () => window.print());
  </script>
</BaseLayout>

<style>
  header {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }
  h1 {
    margin-bottom: 0.6rem;
  }
  .meta {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
  }
  .updated {
    font-size: 0.82rem;
    margin: 0.35rem 0 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0.9rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .tags a {
    color: var(--text-muted);
  }
  .prose :global(h2) {
    padding-top: 0.5rem;
  }
  .back {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }
  .back button {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.35rem 0.7rem;
    cursor: pointer;
  }
  .back button:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
  .source {
    margin-top: 2rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .source span {
    font-family: var(--font-mono);
  }
</style>
