---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { languages, useTranslations, type Lang } from '../../i18n/config';
import { href } from '../../lib/url';
import { getPosts } from '../../lib/posts';

export const getStaticPaths: GetStaticPaths = () =>
  Object.keys(languages).map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = (await getPosts(lang)).slice(0, 5);
---

<BaseLayout lang={lang} altPath="">
  <section class="hero">
    <h1>{t('home.hero.title')}</h1>
  </section>

  <section>
    <h2 class="section-title">{t('home.latest')}</h2>
    {
      posts.length === 0 ? (
        <p class="muted">{t('blog.empty')}</p>
      ) : (
        posts.map((post) => <PostCard post={post} lang={lang} />)
      )
    }
    {
      posts.length > 0 && (
        <p class="all">
          <a href={href(`/${lang}/blog`)}>{t('home.all')} →</a>
        </p>
      )
    }
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 2.25rem 0 1.25rem;
  }
  .hero h1 {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 5.5vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.3;
    margin: 0;
    text-wrap: balance;
  }
  .hero h1::before {
    content: '$ ';
    color: var(--accent);
  }
  .hero h1::after {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.15em;
    vertical-align: -0.15em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero h1::after {
      animation: none;
    }
  }
  .section-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-top: 3.5rem;
    margin-bottom: 0;
  }
  .all {
    margin-top: 1.75rem;
    font-size: 0.95rem;
  }
  @media (max-width: 640px) {
    .hero h1 {
      font-size: 1.8rem;
    }
  }
</style>
