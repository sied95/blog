---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { languages, useTranslations, type Lang } from '../../../i18n/config';
import { href } from '../../../lib/url';
import { getPosts, getTags } from '../../../lib/posts';

export const getStaticPaths: GetStaticPaths = () =>
  Object.keys(languages).map((lang) => ({ params: { lang } }));

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
const posts = await getPosts(lang);
const tags = await getTags(lang);
---

<BaseLayout lang={lang} title={t('blog.title')} altPath="/blog">
  <h1>{t('blog.title')}</h1>

  {
    tags.length > 0 && (
      <ul class="taglist">
        {tags.map(({ tag, count }) => (
          <li>
            <a href={href(`/${lang}/tags/${tag}`)}>
              #{tag} <span class="count">{count}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {
    posts.length === 0 ? (
      <p class="muted">{t('blog.empty')}</p>
    ) : (
      posts.map((post) => <PostCard post={post} lang={lang} />)
    )
  }
</BaseLayout>

<style>
  .taglist {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .taglist a {
    display: inline-block;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.18rem 0.65rem;
    color: var(--text-muted);
  }
  .taglist a:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }
  .count {
    opacity: 0.6;
  }
</style>
